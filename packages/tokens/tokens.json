{
  "color": {
    "yellow": { "$type": "color", "$value": "#FFE15A" },
    "aqua": { "$type": "color", "$value": "#33EEDC" },
    "pink": { "$type": "color", "$value": "#FF7EB9" },
    "pinkText": { "$type": "color", "$value": "#D6478A" },
    "ink": { "$type": "color", "$value": "#141414" },
    "paper": { "$type": "color", "$value": "#FFFDF7" },
    "white": { "$type": "color", "$value": "#FFFFFF" },
    "muted": { "$type": "color", "$value": "#5C5A55" },
    "mutedDark": { "$type": "color", "$value": "#3A3830" },
    "placeholder": { "$type": "color", "$value": "#8A867D" },
    "line": { "$type": "color", "$value": "#EEEAE0" },
    "dash": { "$type": "color", "$value": "#E8E4DA" },
    "dashStrong": { "$type": "color", "$value": "#C9C4B8" },
    "closed": { "$type": "color", "$value": "#E8E4DA" },
    "videoBg": { "$type": "color", "$value": "#1B1A22" },
    "success": { "$type": "color", "$value": "#0E8A7B" },
    "focus": { "$type": "color", "$value": "#2A78D6" }
  },
  "status": {
    "open": { "$type": "color", "$value": "{color.aqua}" },
    "comingSoon": { "$type": "color", "$value": "{color.yellow}" },
    "closed": { "$type": "color", "$value": "{color.closed}" }
  },
  "font": {
    "family": {
      "display": { "$type": "fontFamily", "$value": "Fredoka" },
      "body": { "$type": "fontFamily", "$value": "Nunito" }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold": { "$type": "fontWeight", "$value": 700 },
      "extrabold": { "$type": "fontWeight", "$value": 800 },
      "black": { "$type": "fontWeight", "$value": 900 }
    }
  },
  "type": {
    "hero": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontWeight": 700,
        "fontSize": 84,
        "fontSizePhone": 44,
        "lineHeight": 0.98,
        "letterSpacing": -2
      }
    },
    "h2": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontWeight": 700,
        "fontSize": 44,
        "fontSizePhone": 32,
        "lineHeight": 1.05,
        "letterSpacing": -0.5
      }
    },
    "cardTitle": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontWeight": 700,
        "fontSize": 28,
        "fontSizePhone": 26,
        "lineHeight": 1.05,
        "letterSpacing": 0
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.body}",
        "fontWeight": 600,
        "fontSize": 16,
        "fontSizePhone": 15,
        "lineHeight": 1.5,
        "letterSpacing": 0
      }
    },
    "bodyLg": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.body}",
        "fontWeight": 600,
        "fontSize": 22,
        "fontSizePhone": 18,
        "lineHeight": 1.4,
        "letterSpacing": 0
      }
    },
    "eyebrow": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.body}",
        "fontWeight": 800,
        "fontSize": 12,
        "fontSizePhone": 12,
        "lineHeight": 1.2,
        "letterSpacing": 1.5,
        "textTransform": "uppercase"
      }
    },
    "button": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.body}",
        "fontWeight": 800,
        "fontSize": 16,
        "fontSizePhone": 15,
        "lineHeight": 1.2,
        "letterSpacing": 0
      }
    },
    "nav": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.body}",
        "fontWeight": 800,
        "fontSize": 15,
        "fontSizePhone": 15,
        "lineHeight": 1.2,
        "letterSpacing": 0
      }
    },
    "brand": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontWeight": 700,
        "fontSize": 22,
        "fontSizePhone": 20,
        "lineHeight": 1.1,
        "letterSpacing": 0
      }
    }
  },
  "radius": {
    "chip": { "$type": "dimension", "$value": 999 },
    "input": { "$type": "dimension", "$value": 12 },
    "tile": { "$type": "dimension", "$value": 14 },
    "cardSm": { "$type": "dimension", "$value": 16 },
    "card": { "$type": "dimension", "$value": 22 },
    "cardLg": { "$type": "dimension", "$value": 24 },
    "band": { "$type": "dimension", "$value": 30 }
  },
  "border": {
    "width": { "$type": "dimension", "$value": 2 },
    "color": { "$type": "color", "$value": "{color.ink}" },
    "dashColor": { "$type": "color", "$value": "{color.dash}" }
  },
  "focus": {
    "color": { "$type": "color", "$value": "{color.focus}" },
    "width": { "$type": "dimension", "$value": 3 },
    "offset": { "$type": "dimension", "$value": 2 }
  },
  "shadow": {
    "button": {
      "$type": "shadow",
      "$value": { "offsetX": 3, "offsetY": 3, "blur": 0, "spread": 0, "color": "{color.ink}" }
    },
    "buttonLg": {
      "$type": "shadow",
      "$value": { "offsetX": 4, "offsetY": 4, "blur": 0, "spread": 0, "color": "{color.ink}" }
    },
    "cardYellow": {
      "$type": "shadow",
      "$value": { "offsetX": 6, "offsetY": 6, "blur": 0, "spread": 0, "color": "{color.yellow}" }
    },
    "cardAqua": {
      "$type": "shadow",
      "$value": { "offsetX": 6, "offsetY": 6, "blur": 0, "spread": 0, "color": "{color.aqua}" }
    },
    "cardPink": {
      "$type": "shadow",
      "$value": { "offsetX": 6, "offsetY": 6, "blur": 0, "spread": 0, "color": "{color.pink}" }
    },
    "sheet": {
      "$type": "shadow",
      "$value": {
        "offsetX": 0,
        "offsetY": -6,
        "blur": 20,
        "spread": 0,
        "color": "rgba(0,0,0,0.08)"
      }
    }
  },
  "space": {
    "4": { "$type": "dimension", "$value": 4 },
    "6": { "$type": "dimension", "$value": 6 },
    "8": { "$type": "dimension", "$value": 8 },
    "10": { "$type": "dimension", "$value": 10 },
    "12": { "$type": "dimension", "$value": 12 },
    "14": { "$type": "dimension", "$value": 14 },
    "16": { "$type": "dimension", "$value": 16 },
    "18": { "$type": "dimension", "$value": 18 },
    "20": { "$type": "dimension", "$value": 20 },
    "22": { "$type": "dimension", "$value": 22 },
    "24": { "$type": "dimension", "$value": 24 },
    "28": { "$type": "dimension", "$value": 28 },
    "32": { "$type": "dimension", "$value": 32 },
    "40": { "$type": "dimension", "$value": 40 },
    "48": { "$type": "dimension", "$value": 48 },
    "80": { "$type": "dimension", "$value": 80 },
    "90": { "$type": "dimension", "$value": 90 }
  },
  "layout": {
    "headerHeight": { "$type": "dimension", "$value": 72 },
    "headerPaddingX": { "$type": "dimension", "$value": 48 },
    "logoSize": { "$type": "dimension", "$value": 44 },
    "navGap": { "$type": "dimension", "$value": 28 },
    "cardMaxWidth": { "$type": "dimension", "$value": 1000 },
    "posterColumn": { "$type": "dimension", "$value": 400 },
    "calendarCell": { "$type": "dimension", "$value": 78 },
    "miniCalTile": { "$type": "dimension", "$value": 62 },
    "badgeSize": { "$type": "dimension", "$value": 64 },
    "activityIcon": { "$type": "dimension", "$value": 56 },
    "partnerTileWidth": { "$type": "dimension", "$value": 200 },
    "partnerTileHeight": { "$type": "dimension", "$value": 96 },
    "tapTarget": { "$type": "dimension", "$value": 44 },
    "heroVideoHeight": { "$type": "dimension", "$value": 340 }
  },
  "breakpoint": {
    "phone": { "$type": "dimension", "$value": 768 },
    "desktop": { "$type": "dimension", "$value": 1200 }
  },
  "motion": {
    "press": { "$type": "duration", "$value": 120 },
    "levelUp": { "$type": "duration", "$value": 400 }
  },
  "opacity": {
    "header": { "$type": "number", "$value": 0.94 },
    "takenTable": { "$type": "number", "$value": 0.55 },
    "lockedBadge": { "$type": "number", "$value": 0.5 },
    "scrim": { "$type": "number", "$value": 0.92 }
  }
}
